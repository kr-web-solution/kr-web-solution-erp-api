# Private API — reached only via Docker network (e.g. http://kr-erp-api:8000)
# Public site: https://workspace.krwebsolution.com

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@DB_HOST:5432/kr-web-solution-erp
SECRET_KEY=change-me-long-random-secret
ENCRYPTION_KEY=change-me-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_NAME=kr_access_token

# Bootstrap SUPER_ADMIN (created only when users table is empty)
SUPER_ADMIN_EMAIL=krwebsolutiondev@gmail.com
SUPER_ADMIN_NAME=KR WEB SOLUTION ADMIN
SUPER_ADMIN_PASSWORD=change-me-strong-password

ENVIRONMENT=production
PRODUCTION=true
BACKEND_CORS_ORIGINS=["https://workspace.krwebsolution.com"]
FRONTEND_URL=https://workspace.krwebsolution.com

SMTP_SERVER=smtp.krwebsolution.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PORT=465
SMTP_CONNECTION=SSL
BILLING_MAIL_NAME=KR Web Solution – Billing Team
BILLING_FROM_MAIL=billing@krwebsolution.com

STORAGE_BACKEND=s3
S3_ENDPOINT=s3.krwebsolution.com
S3_CONSOLE_CORS_ORIGINS=https://storage.krwebsolution.com,https://workspace.krwebsolution.com
S3_BUCKET=kr-web-solution-erp-private
S3_PUBLIC_BUCKET=kr-web-solution-erp-public
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

# Google Sign-In — invite-only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID / Outlook — invite-only (SPA redirect = FRONTEND_URL)
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_SECRET=
