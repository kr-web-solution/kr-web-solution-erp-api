# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kr_workspace_erp

# JWT Security — REQUIRED (app refuses known insecure defaults and empty keys outside local/dev)
# Generate SECRET_KEY:  openssl rand -hex 32
# Generate ENCRYPTION_KEY (Fernet):  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you rotate SECRET_KEY, all existing JWTs/cookies/invite/reset tokens become invalid (users must sign in again).
# If you rotate ENCRYPTION_KEY, previously encrypted SMTP passwords cannot be decrypted — re-enter them in Settings.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=

# Bootstrap SUPER_ADMIN (created only when users table is empty)
# May use any domain (Gmail allowed for this account only).
SUPER_ADMIN_EMAIL=krwebsolutiondev@gmail.com
SUPER_ADMIN_NAME=KR WEB SOLUTION ADMIN
SUPER_ADMIN_PASSWORD=ChangeThisStrongPassword123!

# CORS & Server
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FRONTEND_URL=http://localhost:3000

# Object storage (S3-compatible). Documents go in the private bucket.
STORAGE_BACKEND=s3
S3_ENDPOINT=s3.example.com
S3_CONSOLE_CORS_ORIGINS=https://storage.example.com
S3_BUCKET=kr-web-solution-erp-private
S3_PUBLIC_BUCKET=kr-web-solution-erp-public
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_REGION=ap-south-1

# Google Sign-In (OAuth client ID from Google Cloud Console) — invite-only
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Microsoft Entra ID / Outlook — invite-only (SPA + ID token)
# Register an app in Azure Portal → App registrations
# - Platform: Single-page application
# - Redirect URI: http://localhost:3000 (and production UI origin)
# - Expose / allow ID tokens
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_SECRET=
